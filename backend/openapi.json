{
  "openapi": "3.0.3",
  "info": {
    "title": "Ryad Al Aqsa API",
    "description": "REST API for Ryad Al Aqsa Educational Platform",
    "version": "2.0.0",
    "contact": { "name": "Institut Ryad Al Aqsa", "email": "ryad@groupescolaireal-aksa.com" }
  },
  "servers": [{ "url": "http://localhost:3001", "description": "Development" }],
  "paths": {
    "/api/auth/login": { "post": { "summary": "Login", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "login": { "type": "string" }, "password": { "type": "string" }, "portal": { "type": "string", "enum": ["admin_portal", "private"] } }, "required": ["login", "password", "portal"] } } } }, "responses": { "200": { "description": "Success" }, "401": { "description": "Invalid credentials" } } } },
    "/api/auth/refresh": { "post": { "summary": "Refresh access token", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "refreshToken": { "type": "string" } }, "required": ["refreshToken"] } } } }, "responses": { "200": { "description": "New tokens" } } } },
    "/api/admin/overview": { "get": { "summary": "Institution overview", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Overview data" } } } },
    "/api/admin/learning-analytics": { "get": { "summary": "Learning analytics", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Analytics data" } } } },
    "/api/admin/smart-assistant": { "get": { "summary": "Social assistant & agent environment", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Agent data" } } } },
    "/api/admin/impact-report": { "get": { "summary": "Impact report with time-series", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Impact report" } } } },
    "/api/admin/analytics/anonymized": { "get": { "summary": "Anonymized analytics (k-anonymity)", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Anonymized data" } } } },
    "/api/admin/ml/gap-prediction": { "get": { "summary": "ML gap prediction", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Predictions" } } } },
    "/api/admin/ml/early-warning": { "get": { "summary": "Early warning system", "security": [{ "bearerAuth": [] }], "responses": { "200": { "description": "Warnings" } } } },
    "/api/admin/search": { "get": { "summary": "Full-text search", "security": [{ "bearerAuth": [] }], "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" } }, { "name": "type", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "Search results" } } } }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" }
    }
  }
}