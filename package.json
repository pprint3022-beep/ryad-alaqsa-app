{
  "name": "ryad-alaqsa",
  "version": "2.0.0",
  "description": "Ryad Al Aqsa Educational Platform - Monorepo (React web + Fastify API + Prisma + ML)",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:api": "npm run dev -w api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:smoke": "node tests/prototype-smoke.js",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "prettier --check .",
    "db:migrate": "npm run prisma:migrate -w api",
    "db:seed": "npm run prisma:seed -w api",
    "db:studio": "npm run prisma:studio -w api",
    "db:generate": "npm run prisma:generate -w api"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
