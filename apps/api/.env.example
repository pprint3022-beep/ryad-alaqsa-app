NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL connection string. Required when NODE_ENV=production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryad_alaqsa?schema=public

# Must be at least 32 characters. Required when NODE_ENV=production.
# Replace this development value before deploying.
JWT_SECRET=dev-only-insecure-jwt-secret-change-before-production
JWT_EXPIRES_IN=2h
REFRESH_TTL_DAYS=14

# Comma-separated allowed origins, or * to reflect any origin (dev only).
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional. When omitted the API uses an in-memory, TTL-aware cache fallback.
# REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

# Argon2id parameters (OWASP-style baseline: 19 MiB, t=2, p=1).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
